FROM python:3.11-slim
WORKDIR /opt/aira-src
COPY CLI/ ./CLI/
RUN pip install --no-cache-dir ./CLI && useradd -m -u 1000 reviewer
USER reviewer
ENV AIRA_NVIDIA_MODEL="openai/gpt-oss-20b" AIRA_PROVIDER="nvidia" AIRA_TIMEOUT=120 AIRA_MAX_CONTEXT_CHARS=120000
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=5)"
CMD ["python", "-m", "aira.mcp.server", "--host", "0.0.0.0", "--port", "8080"]
